From 3e8f9449b7f5c459327af80ffcc10494666cbc70 Mon Sep 17 00:00:00 2001
From: dnie <dnie@qti.qualcomm.com>
Date: Thu, 5 Nov 2026 10:39:34 +0800
Subject: [PATCH] qrb_ros_nn_inference: fix invalid XML declarations

XML declarations only support version 1.0 or 1.1.

The package manifests incorrectly use the package version 1.1.1 as
the XML version, causing catkin_pkg to reject them during CMake
configuration.

Use XML version 1.0 while keeping the package versions unchanged.

Upstream-Status: Pending

Signed-off-by: dnie <dnie@qti.qualcomm.com>
---
 qrb_ros_nn_inference/package.xml     | 2 +-
 qrb_ros_nn_inference/src/package.xml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/qrb_ros_nn_inference/package.xml b/qrb_ros_nn_inference/package.xml
index d8c9536..3e5e581 100644
--- a/qrb_ros_nn_inference/package.xml
+++ b/qrb_ros_nn_inference/package.xml
@@ -1,4 +1,4 @@
-<?xml version="1.1.1"?>
+<?xml version="1.0"?>
 <?xml-model href="http://download.ros.org/schema/package_format3.xsd"
 schematypens="http://www.w3.org/2001/XMLSchema"?>
 <package format="3">
diff --git a/qrb_ros_nn_inference/src/package.xml b/qrb_ros_nn_inference/src/package.xml
index d8c9536..3e5e581 100644
--- a/qrb_ros_nn_inference/src/package.xml
+++ b/qrb_ros_nn_inference/src/package.xml
@@ -1,4 +1,4 @@
-<?xml version="1.1.1"?>
+<?xml version="1.0"?>
 <?xml-model href="http://download.ros.org/schema/package_format3.xsd"
 schematypens="http://www.w3.org/2001/XMLSchema"?>
 <package format="3">
-- 
2.34.1